{
  "name": "Kite",
  "version": "1.0.1",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsochamp/KiteBrowser.git"
  },
  "config": {
    "forge": {
      "rebuildConfig": {},
      "packagerConfig": {
        "icon": [
            "./build/icon.icns",
            "./Images/icons.icon"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["darwin"]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dsochamp/KiteBrowser/issues"
  },
  "homepage": "https://github.com/dsochamp/KiteBrowser#readme",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
